# Firebase client SDK (browser-safe public config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (required for protected API routes)
# Local option: point to a downloaded Firebase service account JSON file.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-admin.local.json
# Production/Vercel option: paste the full service account JSON as one env var.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Upstream data/script integrations
APPS_SCRIPT_URL=
APPS_SCRIPT_KEY=
TASK_SCRIPT_URL=
GOOGLE_GROUPS_SCRIPT_URL=
GOOGLE_GROUPS_SCRIPT_KEY=
GOOGLE_GROUP_APPROVAL_SCRIPT_URL=
GOOGLE_GROUP_APPROVAL_SCRIPT_KEY=

# Shelter Manager
ASM_BASE_URL=
ASM_ACCOUNT=
ASM_USERNAME=
ASM_PASSWORD=
ASM_API_KEY=
ASM_REPORT_TITLE=Foster History API
ASM_SENSITIVE=1

# Vercel cron
CRON_SECRET=
