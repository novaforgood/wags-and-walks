rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Portal users are gated by Firebase Auth + allowedUsers on the server.
    // Client reads enable real-time VIP/notes sync; writes go through API routes.
    match /applicantOverrides/{email} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /fosterNotes/{email} {
      allow read, write: if request.auth != null;
    }

    match /allowedUsers/{email} {
      allow read: if false;
      allow write: if false;
    }

    match /cache/{docId} {
      allow read, write: if false;
    }
  }
}
